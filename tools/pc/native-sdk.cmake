execute_process(COMMAND "${NM}" --defined-only --extern-only "${EXE}" OUTPUT_VARIABLE listing RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "${NM} failed on ${EXE}")
endif()
string(REPLACE "\n" ";" lines "${listing}")
set(def "LIBRARY pcgame.dll\nEXPORTS\n")
set(skip main wmain WinMain wWinMain DllMain DllMainCRTStartup DllEntryPoint mainCRTStartup WinMainCRTStartup
    atexit NvOptimusEnablement AmdPowerXpressRequestHighPerformance)
set(count 0)
foreach(line ${lines})
    if(NOT line MATCHES "^[0-9a-fA-F]+ ([A-Za-z]) (.+)$")
        continue()
    endif()
    set(kind "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    if(NOT name MATCHES "^(_Z|[A-Za-z])" OR name IN_LIST skip OR kind STREQUAL "A")
        continue()
    endif()
    if(kind STREQUAL "T" OR kind STREQUAL "t")
        string(APPEND def "    ${name}\n")
    else()
        string(APPEND def "    ${name} DATA\n")
    endif()
    math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}/pcgame.def" "${def}")
execute_process(COMMAND "${DLLTOOL}" -m "${MACHINE}" -D pcgame.dll -d "${OUT}/pcgame.def" -l "${OUT}/libpcgame.a"
                RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "${DLLTOOL} could not make libpcgame.a")
endif()
message(STATUS "libpcgame.a: ${count} game symbols")

include("${CMAKE_CURRENT_LIST_DIR}/header-hash.cmake")

string(REPLACE "|" ";" srcs "${SOURCES}")
set(todo "")
foreach(src ${srcs})
    if(NOT IS_ABSOLUTE "${src}")
        set(src "${MODDIR}/${src}")
    endif()
    if(EXISTS "${src}" AND src MATCHES "\\.(c|cc|cpp|cxx|h|hh|hpp)$")
        list(APPEND todo "${src}")
    endif()
endforeach()
set(seen ${todo})
set(found "")
while(todo)
    list(POP_FRONT todo file)
    get_filename_component(dir "${file}" DIRECTORY)
    file(STRINGS "${file}" lines REGEX "^[ \t]*#[ \t]*include[ \t]*[\"<]")
    foreach(line ${lines})
        if(NOT line MATCHES "include[ \t]*[\"<]([^\">]+)[\">]")
            continue()
        endif()
        set(name "${CMAKE_MATCH_1}")
        set(path "")
        foreach(base "${dir}" "${ROOT}/platform/pc/overlay" "${ROOT}" "${MODDIR}")
            if(NOT path AND EXISTS "${base}/${name}" AND NOT IS_DIRECTORY "${base}/${name}")
                get_filename_component(path "${base}/${name}" ABSOLUTE)
            endif()
        endforeach()
        if(NOT path OR path IN_LIST seen)
            continue()
        endif()
        list(APPEND seen "${path}")
        list(APPEND todo "${path}")
        string(FIND "${path}" "${ROOT}/" at)
        if(at EQUAL 0)
            string(LENGTH "${ROOT}/" n)
            string(SUBSTRING "${path}" ${n} -1 rel)
            if(NOT rel MATCHES "^platform/wiiu/shaders/")
                list(APPEND found "${rel}")
            endif()
        endif()
    endforeach()
endwhile()

list(SORT found)
set(text "extern \"C\" __attribute__((section(\".pcabi\"), used)) const char pcNativeModAbi[] =\n")
string(APPEND text "    \"flags ${FLAGS}\\n\"\n")
foreach(rel ${found})
    header_hash("${ROOT}/${rel}" hash)
    string(APPEND text "    \"${rel} ${hash}\\n\"\n")
endforeach()
string(APPEND text "    \"\";\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${text}")
    file(WRITE "${OUT}" "${text}")
endif()

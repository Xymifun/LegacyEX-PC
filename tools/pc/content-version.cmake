include("${CMAKE_CURRENT_LIST_DIR}/header-hash.cmake")
file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/*.cpp" "${ROOT}/*.hpp" "${ROOT}/*.h" "${ROOT}/*.c" "${ROOT}/*.inc")
list(FILTER files EXCLUDE REGEX "^platform/wiiu/shaders/")
list(SORT files)
set(listing "")
set(headers "")
foreach(file ${files})
    file(SHA256 "${ROOT}/${file}" hash)
    string(APPEND listing "${file} ${hash}\n")
    if(file MATCHES "\\.(h|hpp|inc)$")
        header_hash("${ROOT}/${file}" hash)
        string(APPEND headers "    \"${file} ${hash}\\n\"\n")
    endif()
endforeach()
string(SHA256 digest "${listing}")
string(SUBSTRING "${digest}" 0 16 version)
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
string(FIND "${previous}" "\"${version}\"" found)
string(FIND "${previous}" "\"${ABIFLAGS}\"" found2)
if(found EQUAL -1 OR found2 EQUAL -1)
    string(TIMESTAMP now "%s" UTC)
    file(WRITE "${OUTPUT}" "extern const char kPcContentVersion[] = \"${version}\";\n"
                           "extern const unsigned int kPcContentBuildTime = ${now}u;\n"
                           "extern const char kPcAbiFlags[] = \"${ABIFLAGS}\";\n"
                           "extern const char kPcHeaderHashes[] =\n${headers}    \"\";\n")
endif()
if(DEFINED HEADER)
    set(header "#define PC_GAME_BUILD \"${version}\"\n")
    set(previous "")
    if(EXISTS "${HEADER}")
        file(READ "${HEADER}" previous)
    endif()
    if(NOT previous STREQUAL header)
        file(WRITE "${HEADER}" "${header}")
    endif()
endif()

file(GLOB files "${FOLDER}/*.png")
list(SORT files)
set(body "#include \"platform/pc/PcKeyboardGlyphs.hpp\"\n\nnamespace\n{\n")
set(table "")
set(index 0)
foreach(file ${files})
    get_filename_component(name "${file}" NAME_WE)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "const unsigned char kGlyph${index}[] = {${bytes}};\n")
    string(APPEND table "    {\"${name}\", kGlyph${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "}\n\nconst PcKeyboardGlyph kPcKeyboardGlyphs[] = {\n${table}    {0, 0, 0},\n};\n")
string(APPEND body "const unsigned int kPcKeyboardGlyphCount = ${index};\n")
file(WRITE "${OUTPUT}" "${body}")
